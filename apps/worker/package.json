{
  "name": "@fiscaliza/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prompts",
    "prisma.config.ts"
  ],
  "scripts": {
    "postinstall": "prisma generate --generator worker",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --conditions=source --env-file-if-exists=.env src/local-poller.ts",
    "start": "node --env-file-if-exists=.env dist/local-poller.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@fiscaliza/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fiscaliza/config": "workspace:*",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^22.20.5",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
