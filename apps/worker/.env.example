# Copie para .env. Os valores abaixo servem para rodar localmente; nenhum é segredo real.

NODE_ENV=development
# fatal, error, warn, info, debug, trace ou silent
LOG_LEVEL=info

DATABASE_URL=postgresql://fiscaliza:dev@localhost:5432/fiscaliza

AWS_REGION=us-east-1
# LocalStack; deixe vazio na AWS real
AWS_ENDPOINT=http://localhost:4566
# Credenciais aceitas pelo LocalStack; na AWS real use a role ou o perfil, nunca o .env versionado
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Só o local-poller usa; na Lambda a fila entrega as mensagens ao handler
INSPECTIONS_QUEUE_URL=http://localhost:4566/000000000000/fiscaliza-inspections

# Provedores de IA em ordem, separados por vírgula: gemini, fallback e stub.
# O stub gera um relatório determinístico, sem rede nem chave, e é recusado com NODE_ENV=production.
# Exemplo com chaves: LLM_PROVIDERS=gemini,fallback
LLM_PROVIDERS=stub

# Obrigatórias com "gemini" em LLM_PROVIDERS
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# API compatível com OpenAI (Groq, OpenRouter, Ollama). Obrigatórias com "fallback" em LLM_PROVIDERS.
# Exemplo: http://localhost:11434/v1 (Ollama) ou https://api.groq.com/openai/v1
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
