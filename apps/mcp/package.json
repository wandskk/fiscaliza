{
  "name": "@fiscaliza/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --conditions=source --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fiscaliza/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fiscaliza/config": "workspace:*",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
