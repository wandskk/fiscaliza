# Copie para .env. Os valores abaixo servem para rodar localmente; nenhum é segredo real.

# Raiz da API, com o prefixo da versão
FISCALIZA_API_URL=http://localhost:3000/api/v1
# Token de gestor. No modo local da API é "local-manager"; no Cognito, o access token de um
# usuário do grupo manager (expira em 1 hora)
FISCALIZA_API_TOKEN=local-manager
