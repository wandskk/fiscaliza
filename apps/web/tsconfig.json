{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@fiscaliza/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    // Reads @fiscaliza/shared from its src, so dev, typecheck and tests need no build
    "customConditions": ["source"],
    "noEmit": true
  },
  "include": ["src", "vitest.config.ts", "vite.config.ts"]
}
