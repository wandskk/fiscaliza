# Copie para .env. Os valores abaixo servem para o docker compose local; nenhum é segredo real.

NODE_ENV=development
PORT=3000
# Origem do front liberada no CORS
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://fiscaliza:dev@localhost:5432/fiscaliza

AWS_REGION=us-east-1
# LocalStack; deixe vazio na AWS real
AWS_ENDPOINT=http://localhost:4566
# Credenciais aceitas pelo LocalStack; na AWS real use a role ou o perfil, nunca o .env versionado
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PHOTOS_BUCKET=fiscaliza-photos
INSPECTIONS_QUEUE_URL=http://localhost:4566/000000000000/fiscaliza-inspections

# cognito ou local
AUTH_MODE=local
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
