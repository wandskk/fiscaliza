# Copie para .env. Os valores abaixo servem para o docker compose local; nenhum é segredo real.

NODE_ENV=development
PORT=3000
# Origem do front liberada no CORS
CORS_ORIGIN=http://localhost:5173
# fatal, error, warn, info, debug, trace ou silent
LOG_LEVEL=info

DATABASE_URL=postgresql://fiscaliza:dev@localhost:5432/fiscaliza

AWS_REGION=us-east-1
# LocalStack; deixe vazio na AWS real
AWS_ENDPOINT=http://localhost:4566
# Credenciais aceitas pelo LocalStack; na AWS real use a role ou o perfil, nunca o .env versionado
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PHOTOS_BUCKET=fiscaliza-photos
INSPECTIONS_QUEUE_URL=http://localhost:4566/000000000000/fiscaliza-inspections

# local (usuários de teste fixos, Bearer local-inspector, local-inspector-2 ou local-manager)
# ou cognito. Com NODE_ENV=production a API só sobe com cognito.
AUTH_MODE=local
# Obrigatórias com AUTH_MODE=cognito. A região sai do próprio id (us-east-1_AbC123).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
